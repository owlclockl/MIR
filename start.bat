@echo off
rem ============================================================
rem   МИР — запуск игры одним кликом (Windows)
rem   Просто дважды кликните по этому файлу.
rem ============================================================

rem Кириллица в консоли (UTF-8)
chcp 65001 >nul

title МИР — Ролевая онлайн-игра

rem Переходим в папку, где лежит этот bat-файл
cd /d "%~dp0"

echo.
echo  ============================================
echo    Запуск игры "МИР"...
echo  ============================================
echo.

rem Проверяем, что установлен Node.js
where node >nul 2>nul
if errorlevel 1 (
    echo  [ОШИБКА] Node.js не найден!
    echo.
    echo  Установите Node.js с сайта: https://nodejs.org
    echo  После установки запустите этот файл снова.
    echo.
    pause
    exit /b 1
)

rem Запускаем лаунчер: он сам установит зависимости,
rem поднимет сервер и откроет сайт игры в браузере
node start.js

rem Если сервер упал с ошибкой — не закрывать окно сразу
if errorlevel 1 (
    echo.
    echo  Сервер завершился с ошибкой. Смотрите сообщения выше.
    pause
)
