{
  "name": "mir-game-menu",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "single": "node build-single.mjs",
    "build:exe": "node build-exe.mjs",
    "build:apk": "node build-apk.mjs",
    "build:all": "node build-all.mjs",
    "icons": "node icons.mjs",
    "serve": "node serve.mjs",
    "share": "vite build && node serve.mjs",
    "share:public": "vite build && node serve.mjs --public",
    "doctor": "node doctor.mjs",
    "logs": "node -e \"import('node:fs').then(fs => console.log(fs.readFileSync('logs/mir-server.log','utf8')))\""
  },
  "devDependencies": {
    "vite": "^7.1.9"
  }
}
