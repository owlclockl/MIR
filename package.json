{
  "name": "mir-game-menu",
  "description": "The civilization of the sages — русскоязычная картографическая игра для создания и исследования миров.",
  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-web.mjs",
    "fmg:install": "npm ci --ignore-scripts --prefix vendor/azgaar-fantasy-map-generator",
    "fmg:build": "node scripts/build-fmg.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "single": "node scripts/build-single.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "build:apk": "node scripts/build-apk.mjs",
    "apk:doctor": "node scripts/apk-doctor.mjs",
    "build:all": "node scripts/build-all.mjs",
    "icons": "node scripts/icons.mjs",
    "sounds": "node scripts/sounds.mjs",
    "serve": "node server/serve.mjs",
    "start": "node server/serve.mjs",
    "share": "npm run build && node server/serve.mjs",
    "share:public": "npm run build && node server/serve.mjs --public",
    "host": "npm run build && npx --yes wrangler@4 deploy",
    "host:login": "npx --yes wrangler@4 login",
    "host:secret": "npx --yes wrangler@4 secret put MIR_ADMIN_KEY",
    "host:secrets": "npx --yes wrangler@4 secret list",
    "host:dev": "npm run build && npx --yes wrangler@4 dev",
    "host:logs": "npx --yes wrangler@4 tail",
    "doctor": "node scripts/doctor.mjs",
    "logs": "node -e \"import('node:fs').then(fs => console.log(fs.readFileSync('logs/mir-server.log','utf8')))\"",
    "test:p2p": "node scripts/test-p2p.mjs",
    "test:hub": "node scripts/test-hub.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:avatar": "node scripts/test-avatar.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "test:build": "node scripts/test-build.mjs",
    "test:spacing": "node scripts/test-spacing.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.9"
  }
}
