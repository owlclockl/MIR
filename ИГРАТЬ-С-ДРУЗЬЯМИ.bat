@echo off
chcp 65001 >nul
title MIR — сервер для друзей
cd /d "%~dp0"

echo ============================================================
echo   MIR — The civilization of the sages
echo   Запуск игры и сервера для друзей
echo ============================================================
echo.

where node >nul 2>nul
if errorlevel 1 goto :nonode

if exist node_modules goto :deps

echo Первый запуск: устанавливаю зависимости, это пару минут...
call npm install
if errorlevel 1 goto :fail

:deps
echo.
echo Собираю свежую версию игры...
call npm run build
if errorlevel 1 goto :fail

echo.
echo Как будете звать друзей?
echo.
echo   [1] Рядом — та же сеть Wi-Fi. Ссылка вида http://192.168....
echo   [2] Из любой точки интернета. Публичная https-ссылка.
echo.
choice /c 12 /n /m "Нажмите 1 или 2: "
if errorlevel 2 goto :public

echo.
echo ------------------------------------------------------------
echo  Сервер запускается, игра сама откроется в браузере.
echo  Ссылку для друзей скопируйте из этого окна чуть ниже.
echo  Остановить сервер: Ctrl+C или просто закройте окно.
echo  Пока окно открыто — ссылка работает.
echo ------------------------------------------------------------
echo.
start /b "" cmd /c "ping -n 4 127.0.0.1 >nul & start http://localhost:4173/"
node serve.mjs
goto :stopped

:public
echo.
echo ------------------------------------------------------------
echo  Сервер с публичной ссылкой запускается, игра сама откроется
echo  в браузере. https-ссылка для друзей появится ниже через
echo  несколько секунд; при первом запуске туннель скачивается,
echo  это может занять около минуты — подождите.
echo  Остановить сервер: Ctrl+C или просто закройте окно.
echo  Пока окно открыто — ссылка работает.
echo ------------------------------------------------------------
echo.
start /b "" cmd /c "ping -n 4 127.0.0.1 >nul & start http://localhost:4173/"
node serve.mjs --public
goto :stopped

:stopped
echo.
echo ============================================================
echo   Сервер остановлен — ссылки больше не работают.
echo   Запустите этот файл ещё раз, чтобы собрать новую компанию.
echo ============================================================
echo.
pause
exit /b 0

:nonode
echo.
echo   ОШИБКА: не найден Node.js.
echo   1. Скачайте LTS-версию с https://nodejs.org
echo   2. Установите её и запустите этот файл ещё раз.
echo.
pause
exit /b 1

:fail
echo.
echo   ОШИБКА: не получилось собрать игру. Посмотрите сообщения выше
echo   или запустите СБОРКА.bat — он расскажет подробнее.
echo.
pause
exit /b 1
